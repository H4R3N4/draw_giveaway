# Jeton d'accès de Page Facebook (Page Access Token, longue durée).
# Permissions requises sur l'app Meta : pages_read_engagement, pages_show_list.
# La publication analysée doit appartenir à une Page dont vous êtes admin.
FB_PAGE_ACCESS_TOKEN=

# Version de l'API Graph (facultatif).
FB_GRAPH_VERSION=v21.0

# Port du relais d'import (doit correspondre au proxy de vite.config.js).
PORT=5174

# Origines autorisées à appeler le relais, séparées par des virgules.
ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
